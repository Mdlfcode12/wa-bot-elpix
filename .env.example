# --- Gemini ---
# Ambil kunci gratis di https://aistudio.google.com/apikey (tanpa kartu kredit)
GEMINI_API_KEY=AIza...

# Google tidak lagi menerbitkan tabel limit per-model di dokumentasi.
# Cek model apa yang gratis untuk project-mu, beserta RPM/RPD aslinya, di
# https://aistudio.google.com/rate-limit — lalu sesuaikan tiga nilai di bawah.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_TOKENS=400
GEMINI_CONCURRENCY=2

# Setel DI BAWAH limit asli project-mu, jangan sama persis. (free tier flash-lite: 15 RPM, 500 RPD)
GEMINI_RPM_BUDGET=12
GEMINI_RPD_BUDGET=400

BUSINESS_NAME=Toko Contoh

# --- Memory ---
MEMORY_MAX_TURNS=12
MEMORY_MAX_CHARS=6000
MEMORY_TTL_MINUTES=180

# --- Outbound pacing ---
OUT_MIN_DELAY_MS=45000
OUT_MAX_DELAY_MS=180000
OUT_DAILY_CAP=40
OUT_WARMUP_DAYS=7
OUT_WINDOW_START=9
OUT_WINDOW_END=19
TZ=Asia/Jakarta

# --- Google Sheets ---
SHEET_ID=1AbC...
SHEET_RANGE=Contacts!A2:F
GOOGLE_SERVICE_ACCOUNT_JSON=<base64 dari service-account.json>

# --- Infra ---
DATABASE_URL=postgresql://user:pass@host:5432/db
WA_SESSION_ID=default
ADMIN_KEY=ganti-dengan-string-acak-panjang

# Notifikasi push OPSIONAL lewat Telegram, supaya kamu tetap tahu ada
# percakapan yang butuh manusia walau panel sedang tidak terbuka.
# Kosongkan kalau tidak dipakai — peringatan tetap muncul di panel.
# Setup: chat @BotFather -> /newbot -> salin token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NODE_ENV=production
PORT=3000
